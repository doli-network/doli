# NOTE: files already tracked here (see `git ls-files docs/.workflow/`) keep tracking until
# explicitly removed with `git rm --cached`; this rule only stops NEW files being added.
docs/.workflow/
.omega/cortex-config.json
.omega/.pending-imports.jsonl
graphify-out/
scripts/__pycache__/
